APP_NAME=Smart Hospital Unified AI API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

FORECAST_MODEL_PATH=models/checkin_forecast_model.joblib
FORECAST_MODEL_METADATA_PATH=models/model_metadata.json
FORECAST_CHECKIN_DATA_PATH=data/checkin_slots_2026_06.csv
FORECAST_MAX_DAYS=7

CONFIDENCE_THRESHOLD=0.45
TOP_K_DEFAULT=3
ROUTING_MODEL_PATH=models/clinic_room_router.joblib
ROUTING_METADATA_PATH=models/model_metadata.json
ROUTING_DEPARTMENTS_PATH=data/departments.csv

DATABASE_URL=<optional-sqlalchemy-database-url>
AUTH_ENABLED=false
SERVICE_API_KEY=<required-when-auth-enabled>
SERVICE_ACTOR_ID=medflow-backend
SERVICE_API_KEYS=<required-json-map-when-auth-enabled>
TZ=Asia/Ho_Chi_Minh
MONTE_CARLO_RUNS=300
STALE_AFTER_SECONDS=120
MAX_CANDIDATE_ROOMS=20
MODEL_ARTIFACT_DIR=wait_time_module/artifacts
MODEL_SCHEMA_VERSION=1
